# ==============================================================================
# KAAMLY PLATFORM – ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Copy this file to '.env' (local) or '.env.production' (production).
# - Generate secure random passwords (min 32 characters) for all credentials.
# - NEVER commit '.env' or active credentials to Git!
# ==============================================================================

# Application General Settings
APP_NAME=Kaamly
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Public API Gateway URLs (Visible to browser and mobile apps)
APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/app

# Internal Server-to-Server Communication
INTERNAL_API_URL=http://nginx/api/v1

# ------------------------------------------------------------------------------
# PostgreSQL 16 + PostGIS Spatial Database
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kaamly_db
DB_USERNAME=kaamly_app_user
# Generate: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_POSTGRES_PASSWORD

# ------------------------------------------------------------------------------
# Redis 7 (Cache, Sessions, Queues, Distributed Locks)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_REDIS_PASSWORD

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ------------------------------------------------------------------------------
# MinIO Object Storage (S3-Compatible)
# ------------------------------------------------------------------------------
# 1. Root Administrator (Used ONLY for MinIO Console & Initial Bucket Setup)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=kaamly_minio_root_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_MINIO_ROOT_PASSWORD

# 2. Restricted Application IAM User (Used by Laravel for S3 Storage Operations)
MINIO_APP_USER=kaamly_app_s3_user
MINIO_APP_PASSWORD=CHANGE_ME_GENERATE_MINIO_APP_PASSWORD

# Buckets Configuration
MINIO_PRIVATE_BUCKET=kaamly-private-docs
MINIO_PUBLIC_BUCKET=kaamly-public-assets

# Laravel S3 Configuration
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=${MINIO_APP_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_APP_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kaamly-private-docs
AWS_PUBLIC_BUCKET=kaamly-public-assets
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# Laravel Reverb Real-Time WebSockets
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=kaamly_app_1
# Generate: openssl rand -hex 16
REVERB_APP_KEY=CHANGE_ME_HEX_REVERB_KEY
# Generate: openssl rand -hex 32
REVERB_APP_SECRET=CHANGE_ME_HEX_REVERB_SECRET
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

# ------------------------------------------------------------------------------
# Production SSL / TLS Certificate Mount Paths (Host Machine)
# ------------------------------------------------------------------------------
SSL_CERT_PATH=/etc/letsencrypt/live/kaamly.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/kaamly.com/privkey.pem

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging & Third-Party Integrations
# ------------------------------------------------------------------------------
FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-service-account.json

# ------------------------------------------------------------------------------
# Platform Financial Constants
# ------------------------------------------------------------------------------
PLATFORM_DEFAULT_COMMISSION_PERCENT=10.00
PLATFORM_MIN_COMMISSION_PKR=50.00
PLATFORM_MAX_NEGATIVE_WALLET_LIMIT=2000.00
DEFAULT_PROVIDER_RADIUS_KM=10.00
