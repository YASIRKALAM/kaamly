# Root .gitignore for Kaamly Monorepo

# Environment & Secrets
.env
.env.backup
.env.production
.env.staging
*.local
docker-compose.override.yml
*.pem
*.key
*.cert

# Operating System & IDEs
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & Temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend (Laravel / PHP)
backend/.env
backend/.env.backup
backend/.env.production
backend/vendor/
backend/storage/*.key
backend/storage/oauth-*.key
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/.phpunit.result.cache

# Admin Portal (Next.js / Node)
admin-portal/.env*.local
admin-portal/.next/
admin-portal/node_modules/
admin-portal/out/
admin-portal/build/

# Mobile (Flutter / Dart)
mobile/**/.dart_tool/
mobile/**/.flutter-plugins
mobile/**/.flutter-plugins-dependencies
mobile/**/.packages
mobile/**/.pub-cache/
mobile/**/.pub/
mobile/**/build/
mobile/**/android/.gradle/
mobile/**/android/captures/
mobile/**/android/gradlew
mobile/**/android/gradlew.bat
mobile/**/android/local.properties
mobile/**/ios/.generated/
mobile/**/ios/Flutter/App.framework
mobile/**/ios/Flutter/Flutter.framework
mobile/**/ios/Flutter/Generated.xcconfig
mobile/**/ios/Flutter/app.flx
mobile/**/ios/Pods/
mobile/**/ios/Podfile.lock

# Docker / Volumes
data/
pgdata/
redisdata/
miniodata/
